# Copy to .env.local. Never expose the secret key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported instead of SUPABASE_SECRET_KEY.

# Employment applications remain unavailable until this migration is approved/applied
# and the secure submission path is tested. These variables are server-only.
EMPLOYMENT_APPLICATIONS_ENABLED=false
# Generate a separate random secret of at least 32 characters. Never use NEXT_PUBLIC_.
EMPLOYMENT_APPLICATION_SECRET=

# Admin SSR uses the least-privilege publishable key, never the secret key.
SUPABASE_PUBLISHABLE_KEY=
# Legacy SUPABASE_ANON_KEY is supported instead. No NEXT_PUBLIC_ key is required.
